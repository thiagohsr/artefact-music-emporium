# Agent to use. Only the simulated stand-in exists for now.
EMPORIO_AGENT=stand_in

# Show how each reply was produced: 0 (off) or 1 (on). `make run-dev` turns it on.
EMPORIO_TROUBLESHOOTING=0

# Seconds to wait for a reply before showing the failure message.
EMPORIO_REPLY_TIMEOUT_SECONDS=60

# Self-hosted embeddings for `make policy-index` and `make policy-check`, used when the URL is set.
OLLAMA_BASE_URL=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Hosted embeddings for the same commands.
OPENROUTER_API_KEY=
