# Agent to use: store (the default, needs a model provider) or stand_in (simulated, needs nothing).
EMPORIO_AGENT=store

# Show how each reply was produced: 0 (off) or 1 (on). `make run-dev` turns it on.
EMPORIO_TROUBLESHOOTING=0

# Seconds to wait for a reply before showing the failure message.
EMPORIO_REPLY_TIMEOUT_SECONDS=60

# Model providers. Ollama is tried first when its URL is set, and OpenRouter is the fallback.
# On your own Ollama, run: ollama pull qwen3:8b && ollama pull qwen3-embedding:4b
# The chat models can change freely. After changing an embedding model, run: make policy-index
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b
OLLAMA_BASE_URL=

# Only for the project's own server. Not published: ask by replying to the selection process e-mail.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Hosted alternative, which needs no local server.
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=qwen/qwen3-embedding-4b
OPENROUTER_API_KEY=
